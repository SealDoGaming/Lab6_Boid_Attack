// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel BoidCalc


static const int threadGroupSize = 1024;
// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
struct Boid {
    float3 position;
    float3 direction;

    float3 flockDir;
    float3 flockCenter;
    float3 separationDir;
    int flockSize;
};

RWStructuredBuffer<Boid> boids;
int numBoids;
float viewRadius;
float avoidRadius;

[numthreads(threadGroupSize,1,1)]
void BoidCalc (uint3 id : SV_DispatchThreadID)
{

    // TODO: insert actual code here!
    for (int index=0;index<numBoids;index++){

        if(index!=id.x){
            //for all other boids: if offset magnatude is less than viewRadius
            //increment flockSize, and increase flockdirection and center.
            float3 offset = boids[index].position-boids[id.x].position;

            //if we just use both sides already squared, we don't need to do any square rooting for distance, since we just need to compare them
            float offsetDistSqr = offset.x*offset.x+offset.y*offset.y+offset.z*offset.z;

            if(offsetDistSqr <(viewRadius*viewRadius)){
                boids[id.x].flockSize+=1;
                boids[id.x].flockDir+=boids[index].direction;
                boids[id.x].flockCenter+=boids[index].position;

                //if magnatude is less than avoid, subtract heading by the offset, divided by distance so closer=stronger
                if(offsetDistSqr<(avoidRadius*avoidRadius)){

                    boids[id.x].separationDir -= offset/offsetDistSqr;
                }
            }
            

        }

    }
}
