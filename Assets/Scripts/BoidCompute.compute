// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel BoidCalc


static const int threadGroupSize = 1024;
// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture

struct Target {
    float3 position;
    float radius;
    float weight;
};

struct Boid {
    float3 position;
    float3 direction;

    float3 flockDir;
    float3 flockCenter;
    float3 separationDir;

    float3 targetDir;
    //int targetCount;

    float fearLevel;
    float fearLevelChange;
    float flockFearLevel;

    int flockSize;

    int isDead;
    
    int localGridIndex;
};

RWStructuredBuffer<Target> targets;
int numTargets;
RWStructuredBuffer<Boid> boids;
RWStructuredBuffer<int> indexBuffer;
RWStructuredBuffer<int> localOffsetBuffer;
int numBoids;
int gridXMax;
int gridZMax;
int gridYMax;
float viewRadius;
float avoidRadius;
float maxFear;
float3 playerPosition;

[numthreads(threadGroupSize,1,1)]
void BoidCalc (uint3 id : SV_DispatchThreadID)
{
    
    //Things to Add to ComputeBuffer
    //localOffsetBuffer
    //code that takes the localgrid index and checks each valid localgrid
    // TODO: insert actual code here!
    for(int offsetIndex=0;offsetIndex<27;offsetIndex++){
        int region = boids[id.x].localGridIndex+localOffsetBuffer[offsetIndex];
        int startIndex = indexBuffer[region];
        int regionSize = indexBuffer[region+1]-startIndex;

        for(int index = startIndex; index<startIndex+regionSize;index++){
            if(index!=id.x){
                //for all other boids: if offset magnatude is less than viewRadius
                //increment flockSize, and increase flockdirection and center.
                float3 offset = boids[index].position-boids[id.x].position;

                //if we just use both sides already squared, we don't need to do any square rooting for distance, since we just need to compare them
                float offsetDistSqr = offset.x*offset.x+offset.y*offset.y+offset.z*offset.z;

                if(offsetDistSqr < (viewRadius*viewRadius)){
                    if(boids[index].isDead){
                        if(boids[id.x].fearLevel<maxFear){
                            boids[id.x].fearLevelChange+=1;
                        }
                        continue;
                    }
                    boids[id.x].flockSize+=1;
                    boids[id.x].flockDir+=boids[index].direction;
                    boids[id.x].flockCenter+=boids[index].position;
                    boids[id.x].flockFearLevel+=boids[index].fearLevel;
                    //if magnatude is less than avoid, subtract heading by the offset, divided by distance so closer=stronger
                    if(offsetDistSqr<(avoidRadius*avoidRadius)){

                        boids[id.x].separationDir -= offset/offsetDistSqr;
                    }
                }
            

            }
        }
    }


    /*
    for (int index=0;index<numBoids;index++){
        if(index!=id.x){
            //for all other boids: if offset magnatude is less than viewRadius
            //increment flockSize, and increase flockdirection and center.
            float3 offset = boids[index].position-boids[id.x].position;

            //if we just use both sides already squared, we don't need to do any square rooting for distance, since we just need to compare them
            float3 offsetDistSqr = offset.x*offset.x+offset.y*offset.y+offset.z*offset.z;

            if(offsetDistSqr <(viewRadius*viewRadius)){
                if(boids[index].isDead){
                    //if(boids[id.x].fearLevel<maxFear){
                    //    boids[id.x].fearLevelChange+=1;
                    //}
                    continue;
                }
                boids[id.x].flockSize+=1;
                boids[id.x].flockDir+=boids[index].direction;
                boids[id.x].flockCenter+=boids[index].position;
                boids[id.x].flockFearLevel+=boids[index].fearLevel;
                //if magnatude is less than avoid, subtract heading by the offset, divided by distance so closer=stronger
                if(offsetDistSqr<(avoidRadius*avoidRadius)){

                    boids[id.x].separationDir -= offset/offsetDistSqr;
                }
            }
        }
    }
    float dist = 999;
    for(int index=0;index<numTargets;index++){
        float3 offset = targets[index].position-boids[id.x].position;
        float targetRadius = targets[index].radius;
        float offsetDistSqr = offset.x*offset.x+offset.y*offset.y+offset.z*offset.z;
        if(offsetDistSqr <(targetRadius*targetRadius) && offsetDistSqr<dist){
            dist = offsetDistSqr;
            boids[id.x].targetDir= (offset/offsetDistSqr)*targets[index].weight;
        }
        
    }

}
